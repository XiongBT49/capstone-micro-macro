    "procurement_plan": {
      "source": "owner_organization_model_proposal",
      "reason": "依据业主成员讨论收敛的结论：当前判给信心的瓶颈是施工包之间工程量与计价边界未定，包数、材料采购归属、质量验收界面和交通影响窗口均无法定稿。故按陈志远与苏丽华牵头要求，以按施工包拆分的工程量与计价边界为定包依据，先设两个并行包作为首次试行，符合情景允许的至少两个、最多四个范围。两包按工程部位与工序界面切分：土建排水主体包与交通配套照明绿化包，接口仅限路面完成面标高与预埋管线，材料均由各包自行采购并在招标文件中写明归属，避免重复计价与界面真空。施工总预算按总预算MOP 150,000,000的85%即MOP 127,500,000计，两包份额合计1.00，即占施工总预算的100%，与施工总预算口径一致；设计3%、造价1.5%及业主预备金约10.5%不在施工包份额内。暂不增设更多包，因现有讨论未提供可核实的第三类独立工程量边界，增设将放大接口与重复计价风险，待边界草案核实后再评估。",
      "base_data_version": "4e3fba8f54c5761b0000d5abff9bc861ef707db186c9d482e8790414e4cf055b",
      "numeric_approval": "DBB structure and budget/dependency validation"
    }
