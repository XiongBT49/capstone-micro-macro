    "procurement_plan": {
      "source": "owner_organization_model_proposal",
      "reason": "按情景假设，总预算1.5亿MOP中施工总预算为85%即1.275亿MOP，两个施工包份额合计1.00（即施工预算的100%），与施工预算口径一致，不占用设计与造价服务费及业主预备金。首轮试行采用两个并行包，理由是：护岸结构加固与路面恢复、排水改移在施工界面和验收路径上可清晰切分，前者为临水结构主体作业，后者为结构完成后的恢复与接驳作业，交接点明确，可避免临时工程、围堰与交通疏解重复计价。业主讨论中陈志明、黄丽贞、李国豪、苏美玲、何家俊均指向同一前置条件：施工包界面与计价边界须由在先的设计与造价服务锁定后再起草招标文件。因此本方案作为包划分与份额建议，施工包招标时序应排在设计与造价服务交付节点之后；若后续设计深化显示护岸结构与恢复作业界面无法独立验收，再评估是否增设包，但当前两个包已满足无重复计价与可分别采购的要求。",
      "base_data_version": "1fae566e14c016a697051043194acd421ea0e7053ed2b7ddb430bc0f09bb2877",
      "numeric_approval": "DBB structure and budget/dependency validation"
    }
